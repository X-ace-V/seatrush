  {"type": "timeseries", "title": "Replica lag", "description": "How far the replica has replayed. Bytes, not seconds: time-based lag grows while idle even when caught up.", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "max(pg_stat_replication_pg_wal_lsn_diff)", "legendFormat": "WAL bytes behind primary"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#3987e5"}}]}]}, "options": {"legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
