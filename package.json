{
  "name": "seatrush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flash-sale ticket booking system, scaled stage by stage",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "seed": "node scripts/seed.ts",
    "check": "node scripts/check.ts",
    "load": "docker run --rm -i -e VUS -e DURATION -e SEATS grafana/k6 run - < load/book.js"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
