  {"type": "stat", "title": "Outbox backlog", "description": "Committed payments not yet published to Kafka. Grows while Kafka is down.", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4}, "targets": [{"refId": "A", "expr": "max(outbox_backlog)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
