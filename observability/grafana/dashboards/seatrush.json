{"uid": "seatrush", "title": "seatrush", "refresh": "5s", "time": {"from": "now-15m", "to": "now"}, "schemaVersion": 41, "editable": true,
 "panels": [
  {"type": "stat", "title": "App replicas up", "description": "", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}, "targets": [{"refId": "A", "expr": "count(up{job=\"app\"} == 1)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"type": "stat", "title": "Holds served / s", "description": "201 held + 409 taken. Excludes 503s.", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}, "targets": [{"refId": "A", "expr": "sum(rate(http_request_duration_seconds_count{route=\"POST /holds\",status=~\"201|409\"}[10s]))"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"type": "stat", "title": "Hold p99", "description": "", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"POST /holds\"}[10s])))"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": null}}, "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"type": "stat", "title": "Holds shed", "description": "Share of hold requests turned away by load shedding (503).", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4}, "targets": [{"refId": "A", "expr": "sum(rate(http_request_duration_seconds_count{route=\"POST /holds\",status=\"503\"}[10s])) / sum(rate(http_request_duration_seconds_count{route=\"POST /holds\"}[10s]))"}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": null}}, "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
